generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Buyer {
  id       Int    @id @default(autoincrement())
  name     String
  phone    String
  location String
  crop     String
  quantity Int
  price    Float
}

model Farmer {
  id        Int      @id @default(autoincrement())
  name      String
  phone     String
  village   String
  crop      String
  land_size Float
  createdAt DateTime @default(now())
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  messages     Message[]
}

model Message {
  id        String   @id @default(cuid())
  role      Role
  content   String
  createdAt DateTime @default(now())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

enum Role {
  user
  assistant
}
